# --- data (large, licensed, must never be committed) ---
data
cache/

# --- environment ---
.venv/
.vscode/
__pycache__/
*.pyc
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/

# --- private working notes, not part of the public deliverable ---
HANDOFF.md
*-study-plan.md
TECH_SPEC.md

# --- rendered review figures, regenerated by `python -m src.render_figures`;
#     the report keeps its own copies under report/ ---
/figures/

# --- working notes and reference material, never committed ---
information/

# --- LibreOffice lock files ---
.~lock*

# --- report: only the PDFs are tracked; the markdown sources and figures stay local ---
report/*
!report/*.pdf
